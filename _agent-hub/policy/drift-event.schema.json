{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConfigDriftEvent",
  "type": "object",
  "required": ["ts", "source", "expected", "actual", "severity", "action"],
  "properties": {
    "ts": {"type": "string", "format": "date-time"},
    "source": {"type": "string"},
    "expected": {"type": "object"},
    "actual": {"type": "object"},
    "severity": {"enum": ["L1", "L2", "L3"]},
    "action": {"enum": ["auto_rollback", "queued_for_review", "blocked_pending_change"]},
    "evidence_ref": {"type": "string"}
  }
}

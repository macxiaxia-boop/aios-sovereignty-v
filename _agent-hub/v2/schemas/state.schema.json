{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aios.local/schemas/state.schema.json",
  "title": "AIOS Hub v2 State Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updated_at", "tasks", "agents"],
  "properties": {
    "version": { "type": "string" },
    "updated_at": { "type": "string", "format": "date-time" },
    "tasks": {
      "type": "object",
      "additionalProperties": { "$ref": "task.schema.json" }
    },
    "agents": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "agent_id": { "type": "string" },
          "status": { "type": "string", "enum": ["alive", "stale", "dead", "unknown"] },
          "last_heartbeat_at": { "type": ["string", "null"], "format": "date-time" },
          "current_task_id": { "type": ["string", "null"] },
          "reachable": { "type": "boolean" },
          "transport": { "type": "string" },
          "details": { "type": "object" }
        }
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    }
  }
}
#!/usr/bin/env bash
# AIOS Kernel pre-commit hook (R1503-FINAL gap-fill).
#
# Install with:
#   git config core.hooksPath .githooks
#
# Runs:
#   - ruff (lint)
#   - pytest (unit + integration tests, fast subset)
#
# Set SKIP_AIOS_HOOKS=1 to bypass in emergencies.

set -euo pipefail

if [[ "${SKIP_AIOS_HOOKS:-0}" == "1" ]]; then
    exit 0
fi

cd "$(git rev-parse --show-toplevel)"

echo "[aios-kernel pre-commit] ruff check..."
if command -v ruff >/dev/null 2>&1; then
    ruff check src/ tests/ || {
        echo "  ruff failed; aborting commit."
        echo "  To bypass: SKIP_AIOS_HOOKS=1 git commit ..."
        exit 1
    }
else
    echo "  ruff not installed; skipping lint"
fi

echo "[aios-kernel pre-commit] pytest (R1503 unit)..."
PYTHON="${PYTHON:-python}"
if [[ -d ".venv" ]]; then
    # Windows + POSIX dual support
    if [[ -f ".venv/Scripts/python.exe" ]]; then
        PYTHON=".venv/Scripts/python.exe"   # Windows (Git Bash)
    elif [[ -f ".venv/bin/python" ]]; then
        PYTHON=".venv/bin/python"          # POSIX (Linux/macOS)
    fi
fi

# Only R1503-relevant tests (test_goal_guard is pre-existing historical flake)
$PYTHON -m pytest \
    tests/unit/test_scheduler.py \
    tests/unit/test_state_machine.py \
    tests/unit/test_adapters.py \
    tests/unit/test_agents.py \
    tests/unit/test_gateway.py \
    tests/unit/test_runtime.py \
    tests/unit/test_scheduler_audit.py \
    tests/integration/ \
    -q --no-header -p no:cacheprovider 2>&1 | tail -5 || {
    echo "  unit tests failed; aborting commit."
    echo "  To bypass: SKIP_AIOS_HOOKS=1 git commit ..."
    exit 1
}

echo "[aios-kernel pre-commit] ✅ passed"
exit 0